---
import Base from "../../layouts/Base.astro";
import { loadSkills, loadProcesses } from "../../lib/data";

const skills = loadSkills();
const base = import.meta.env.BASE_URL;

// build processId → process title map for the link label
const procTitles = new Map(loadProcesses().map((p) => [p.name, p.title]));
---

<Base
  title="Skills"
  subtitle={`${skills.length} SKILL.md files generated by the design-time flow, written in the Agent Skills Standard format.`}
>
  <ul class="divide-y divide-rule border-y border-rule">
    {skills.map((s) => (
      <li class="py-5">
        <div class="flex items-start justify-between gap-6">
          <div class="min-w-0 flex-1">
            <a href={`${base}skills/${s.skillId}/`} class="group">
              <div class="font-mono text-[10px] text-ink-subtle">{s.skillId} · {s.processType.toUpperCase()}</div>
              <div class="mt-0.5 font-semibold text-ink group-hover:underline underline-offset-2">
                {procTitles.get(s.skillId) ?? s.name}
              </div>
            </a>
            <p class="mt-1 text-xs text-ink-muted line-clamp-2 max-w-2xl leading-relaxed">
              {s.description}
            </p>
            <a
              href={`${base}processes/${s.skillId}/`}
              class="inline-flex items-center gap-1 mt-2 text-[10px] font-mono text-accent-ink hover:underline underline-offset-2"
            >
              → view process model
            </a>
          </div>
          <a
            href={`${base}skills/${s.skillId}/`}
            class="shrink-0 text-right text-xs text-ink-subtle font-mono hover:text-ink"
          >
            <div>{s.steps.filter((st) => st.ordConfirmed.length > 0).length} GT steps</div>
            <div>{s.steps.length} total</div>
          </a>
        </div>
      </li>
    ))}
  </ul>
</Base>
