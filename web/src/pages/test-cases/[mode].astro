---
import Base from "../../layouts/Base.astro";
import { loadRuntimeCases, groupByMode, loadSystems, loadSkills, loadProcesses } from "../../lib/data";

export async function getStaticPaths() {
  const cases = loadRuntimeCases();
  const grouped = groupByMode(cases);
  const meta: Record<string, { label: string; sub: string }> = {
    skill_guided:  { label: "Skill-Guided", sub: "Explicit + Conditional Multi-Step" },
    skill_adjusted: { label: "Skill-Adjusted", sub: "Implicit Multi-Step" },
    dynamic:       { label: "Dynamic", sub: "Single-Intent + Multi-Intent" },
    out_of_scope:  { label: "Out-of-Scope", sub: "Refusal" },
  };
  return Object.entries(grouped).map(([key, cs]) => ({
    params: { mode: key.replace(/_/g, "-") },
    props: { mode: key, ...meta[key], cases: cs },
  }));
}

const { mode, label, sub, cases } = Astro.props;
const base = import.meta.env.BASE_URL;

const ordIndex = new Map<string, { namespace: string; slug: string; title: string }>();
for (const sys of loadSystems()) {
  for (const r of sys.resources) {
    ordIndex.set(r.ordId, { namespace: sys.namespace, slug: r.slug, title: r.title });
  }
}

// skill/process context for SG + SA
const skillMap = new Map(loadSkills().map((s) => [s.skillId, s]));
const processMap = new Map(loadProcesses().map((p) => [p.name, p]));

function ordLink(oid: string) {
  const r = ordIndex.get(oid);
  return r ? { href: `${base}landscape/${r.namespace}/${r.slug}/`, title: r.title } : null;
}
---

<Base title={label} subtitle={`${cases.length} cases · ${sub}`}>
  <div class="font-mono text-xs text-ink-subtle mb-6 flex items-center gap-2">
    <a href={`${base}test-cases/`} class="hover:text-ink underline-offset-2 hover:underline">Test Cases</a>
    <span>·</span>
    <a href={`${base}test-cases/runtime/`} class="hover:text-ink underline-offset-2 hover:underline">Run-Time</a>
    <span>·</span>
    <span class="text-ink">{label}</span>
  </div>

  <ul class="divide-y divide-rule border-y border-rule">
    {cases.map((c) => {
      const gtIds = c.expected_ordIds ?? c.expected_steps?.map((s) => s.expected_ordIds[0]).filter(Boolean) ?? [];
      const gapIds = c.expected_gap_ordIds ?? [];
      const problems = c.problems_exercised ?? [];

      return (
        <li class="py-5 border-b border-rule">
          {(() => {
            const skillId = c.expected_skill_id ?? c.skill_id;
            const skill = skillId ? skillMap.get(skillId) : null;
            const proc = skillId ? processMap.get(skillId) : null;
            const hasSideBySide = (mode === "skill_guided" || mode === "skill_adjusted") && (skill || proc);

            return (
              <div class={hasSideBySide ? "grid grid-cols-1 md:grid-cols-2 gap-4" : ""}>
                {/* Left: prompt + metadata */}
                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-2 mb-1.5">
                    <span class="font-mono text-[10px] text-ink-subtle">{c.case_id}</span>
                    {c.query_class && (
                      <span class="font-mono text-[10px] px-1.5 py-0.5 rounded bg-rule text-ink-subtle">
                        {c.query_class.replace(/_/g, " ")}
                      </span>
                    )}
                    {problems.map((p) => (
                      <span class="font-mono text-[10px] px-1.5 py-0.5 rounded bg-accent/10 text-accent-ink border border-accent/20">
                        {p}
                      </span>
                    ))}
                    {skillId && (
                      <a href={`${base}skills/${skillId}/`}
                         class="font-mono text-[10px] px-1.5 py-0.5 rounded bg-green-50 border border-green-200 text-green-700 hover:bg-green-100">
                        {skillId}
                      </a>
                    )}
                  </div>
                  <p class="text-sm text-ink leading-relaxed mb-2">{c.user_prompt}</p>

                  {/* GT resources */}
                  {gtIds.length > 0 && (
                    <div class="flex flex-wrap gap-1.5 mt-2">
                      {gtIds.map((oid) => {
                        const link = ordLink(oid);
                        return link ? (
                          <a href={link.href}
                             class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-green-50 border border-green-200 text-[10px] font-mono text-green-700 hover:bg-green-100">
                            <span class="w-1.5 h-1.5 rounded-full bg-green-500 shrink-0"></span>
                            {link.title}
                          </a>
                        ) : (
                          <span class="font-mono text-[10px] text-ink-subtle px-2 py-0.5 rounded bg-rule">{oid.split(":")[2]}</span>
                        );
                      })}
                    </div>
                  )}

                  {/* Gap resources for SA */}
                  {gapIds.length > 0 && (
                    <div class="flex flex-wrap gap-1.5 mt-1">
                      {gapIds.map((oid) => {
                        const link = ordLink(oid);
                        return link ? (
                          <a href={link.href}
                             class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-yellow-50 border border-yellow-200 text-[10px] font-mono text-yellow-700 hover:bg-yellow-100">
                            <span class="w-1.5 h-1.5 rounded-full bg-yellow-500 shrink-0"></span>
                            gap: {link.title}
                          </a>
                        ) : null;
                      })}
                    </div>
                  )}

                  {/* OOS topic */}
                  {c.topic && (
                    <div class="mt-1 font-mono text-[10px] text-ink-subtle italic">{c.topic}</div>
                  )}
                </div>

                {/* Right: process/skill context (SG + SA only) */}
                {hasSideBySide && (
                  <div class="border-l border-green-200 pl-4 flex flex-col gap-2">
                    <a href={`${base}processes/${skillId}/`}
                       class="text-xs font-semibold text-ink hover:underline underline-offset-2">
                      {proc?.title ?? skillId}
                    </a>
                    {skill?.description && (
                      <p class="text-[11px] text-ink-muted leading-relaxed">
                        {skill.description}
                      </p>
                    )}
                    {proc && (
                      <a href={`${base}processes/${skillId}/`}
                         class="text-[10px] font-mono text-accent-ink hover:underline mt-auto">
                        view process →
                      </a>
                    )}
                  </div>
                )}
              </div>
            );
          })()}
        </li>
        </li>
      );
    })}
  </ul>
</Base>
