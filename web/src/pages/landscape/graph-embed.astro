---
// Standalone, chrome-less landscape graph for embedding in the thesis
// presentation via <iframe>. No Base layout (no header, nav, footer),
// pure white background, fills the viewport. Mirrors the interaction
// logic of landscape/graph.astro.
import { buildLandscapeGraph } from "../../lib/data";

const graph = buildLandscapeGraph();
const base = import.meta.env.BASE_URL;
const graphJson = JSON.stringify(graph);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Landscape graph — embed</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <style>
      * { box-sizing: border-box; }
      html, body {
        margin: 0; padding: 0; width: 100%; height: 100%;
        background: #ffffff;
        font-family: Inter, system-ui, sans-serif;
        color: #111;
        overflow: hidden;
      }
      #wrap { display: flex; flex-direction: column; height: 100vh; padding: 6px 10px; gap: 4px; }
      .legend, .controls { display: flex; flex-wrap: wrap; align-items: center; gap: 3px 8px; font-size: 8.5px; }
      .legend .lbl, .controls .lbl { font-family: 'JetBrains Mono', monospace; text-transform: uppercase; letter-spacing: 0.04em; color: #888; }
      .swatch { display: inline-flex; align-items: center; gap: 3px; }
      .swatch i { display: inline-block; width: 8px; height: 8px; }
      .rounded-sm { border-radius: 2px; }
      .rounded-full { border-radius: 9999px; }
      .rot45 { transform: rotate(45deg); }
      .line { display: inline-block; width: 14px; height: 2px; }
      .controls button, .controls label {
        border: 1px solid #e5e5e5; border-radius: 4px; padding: 2px 6px;
        cursor: pointer; display: inline-flex; align-items: center; gap: 4px; background: #fff;
      }
      .controls button:hover, .controls label:hover { border-color: #0f766e; color: #0f766e; }
      .controls input { accent-color: #0f766e; width: 9px; height: 9px; }
      #cy-wrap { position: relative; flex: 1; border: 1px solid #e5e5e5; border-radius: 8px; background: #fff; overflow: hidden; }
      #cy { width: 100%; height: 100%; }
      #g-panel {
        position: absolute; right: 16px; top: 16px; width: 300px;
        background: #fff; border: 1px solid #e5e5e5; border-radius: 8px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.12); padding: 16px; font-size: 14px;
      }
      #g-panel.hidden { display: none; }
      #g-panel-kind { font-family: 'JetBrains Mono', monospace; font-size: 10px; text-transform: uppercase; letter-spacing: 0.05em; color: #888; margin-bottom: 4px; }
      #g-panel-title { font-weight: 500; margin-bottom: 4px; }
      #g-panel-ordid { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #888; margin-bottom: 12px; word-break: break-all; }
      #g-panel-neighbors { font-size: 12px; color: #555; }
      #g-panel-close { position: absolute; top: 8px; right: 12px; color: #888; cursor: pointer; font-size: 18px; line-height: 1; border: none; background: none; }
    </style>
  </head>
  <body>
    <div id="wrap">
      <!-- Legend -->
      <div class="legend">
        <span class="lbl">Nodes:</span>
        <span class="swatch"><i class="rounded-sm" style="background:#0f766e"></i>System</span>
        <span class="swatch"><i class="rounded-full" style="background:#7c3aed"></i>Agent</span>
        <span class="swatch"><i class="rounded-sm" style="background:#1d4ed8"></i>API</span>
        <span class="swatch"><i class="rounded-sm" style="background:#0891b2"></i>Data product</span>
        <span class="swatch"><i class="rounded-full" style="background:#f59e0b"></i>Business Object</span>
        <span class="swatch"><i class="rot45" style="background:#dc2626"></i>Process</span>
        <span class="lbl" style="margin-left:8px">Edges:</span>
        <span class="swatch"><i class="line" style="background:#9ca3af"></i>hosts</span>
        <span class="swatch"><i class="line" style="background:#f59e0b"></i>entities</span>
        <span class="swatch"><i class="line" style="background:#7c3aed"></i>calls</span>
      </div>

      <!-- Controls -->
      <div class="controls">
        <button id="g-fit">fit</button>
        <span class="lbl" style="padding-left:6px">Nodes:</span>
        <label><input type="checkbox" class="node-toggle" data-node-kind="system" checked />Systems</label>
        <label><input type="checkbox" class="node-toggle" data-node-kind="agent" checked />Agents</label>
        <label><input type="checkbox" class="node-toggle" data-node-kind="apiResource" checked />APIs</label>
        <label><input type="checkbox" class="node-toggle" data-node-kind="dataProduct" checked />Data Products</label>
        <label><input type="checkbox" class="node-toggle" data-node-kind="entityType" checked />Entities</label>
        <label><input type="checkbox" class="node-toggle" data-node-kind="process" />Processes</label>
        <span class="lbl" style="padding-left:6px">Edges:</span>
        <label><input type="checkbox" class="edge-toggle" data-edge-kind="entities" checked />entities</label>
        <label><input type="checkbox" class="edge-toggle" data-edge-kind="calls" checked />calls</label>
        <label><input type="checkbox" class="edge-toggle" data-edge-kind="processNext" data-edge-filter="true" />processNext</label>
        <label><input type="checkbox" class="edge-toggle" data-edge-kind="partOfGroups" data-edge-filter="true" />partOfGroups</label>
      </div>

      <!-- Graph -->
      <div id="cy-wrap">
        <div id="cy"></div>
        <div id="g-panel" class="hidden">
          <div id="g-panel-kind">node</div>
          <div id="g-panel-title">—</div>
          <div id="g-panel-ordid"></div>
          <div id="g-panel-neighbors">—</div>
          <button id="g-panel-close">×</button>
        </div>
      </div>
    </div>

    <script type="application/json" id="graph-data" data-base={base} set:html={graphJson}></script>

    <script>
      import cytoscape from "cytoscape";
      // @ts-ignore
      import fcose from "cytoscape-fcose";
      cytoscape.use(fcose);

      const graphDataEl = document.getElementById("graph-data") as HTMLScriptElement;
      const payload = JSON.parse(graphDataEl.textContent || "{}");

      const LAYOUT_OPTS = {
        name: "fcose", animate: false, randomize: true, quality: "proof",
        nodeRepulsion: 12000, idealEdgeLength: 160, edgeElasticity: 0.3,
        gravity: 0.15, gravityRangeCompound: 1.5, numIter: 4500, tile: true,
        tilingPaddingVertical: 25, tilingPaddingHorizontal: 25, nodeSeparation: 90,
        nodeDimensionsIncludeLabels: true, packComponents: true, uniformNodeDimensions: false,
      };

      const elements = [
        ...payload.nodes.map((n: any) => ({ group: "nodes" as const, data: { ...n } })),
        ...payload.edges.map((e: any) => ({ group: "edges" as const, data: { ...e }, classes: e.kind })),
      ];

      const cy = cytoscape({
        container: document.getElementById("cy"),
        elements, wheelSensitivity: 0.2, minZoom: 0.15, maxZoom: 3,
        style: [
          { selector: "node", style: { "label": "data(label)", "font-family": "Inter, system-ui, sans-serif", "font-size": 11, "color": "#111", "text-valign": "bottom", "text-margin-y": 4, "text-wrap": "wrap", "text-max-width": 90, "text-background-color": "#ffffff", "text-background-opacity": 0.85, "text-background-padding": 2, "text-background-shape": "roundrectangle", "border-width": 1, "border-color": "#fff", "transition-property": "opacity, border-width, border-color", "transition-duration": 150 } },
          { selector: 'node[kind = "system"]', style: { "background-color": "#0f766e", "shape": "round-rectangle", "width": "mapData(degree, 1, 25, 60, 110)", "height": "mapData(degree, 1, 25, 38, 66)", "font-size": 13, "font-weight": 600, "color": "#fff", "text-valign": "center", "text-margin-y": 0, "text-outline-width": 0, "text-background-opacity": 0 } },
          { selector: 'node[kind = "agent"]', style: { "background-color": "#7c3aed", "shape": "ellipse", "width": "mapData(degree, 1, 10, 24, 42)", "height": "mapData(degree, 1, 10, 24, 42)" } },
          { selector: 'node[kind = "apiResource"]', style: { "background-color": "#1d4ed8", "shape": "round-rectangle", "width": "mapData(degree, 1, 10, 26, 44)", "height": "mapData(degree, 1, 10, 20, 30)" } },
          { selector: 'node[kind = "dataProduct"]', style: { "background-color": "#0891b2", "shape": "round-diamond", "width": "mapData(degree, 1, 10, 24, 40)", "height": "mapData(degree, 1, 10, 24, 40)" } },
          { selector: 'node[kind = "entityType"]', style: { "background-color": "#f59e0b", "color": "#7c2d12", "shape": "ellipse", "width": "mapData(degree, 1, 12, 18, 56)", "height": "mapData(degree, 1, 12, 18, 56)", "font-size": 10 } },
          { selector: 'node[kind = "process"]', style: { "background-color": "#dc2626", "color": "#7f1d1d", "shape": "diamond", "width": 20, "height": 20, "font-size": 8 } },
          { selector: "edge", style: { "width": 1, "curve-style": "bezier", "opacity": 0.6, "line-color": "#9ca3af", "target-arrow-color": "#9ca3af", "transition-property": "opacity, line-color, width", "transition-duration": 150 } },
          { selector: "edge.hosts", style: { "line-color": "#9ca3af", "opacity": 0.45 } },
          { selector: "edge.entities", style: { "line-color": "#f59e0b", "opacity": 0.55 } },
          { selector: "edge.calls", style: { "line-color": "#7c3aed", "target-arrow-shape": "triangle", "target-arrow-color": "#7c3aed", "width": 1.6, "opacity": 0.75 } },
          { selector: "edge.processNext", style: { "line-color": "#0f766e", "target-arrow-shape": "triangle", "target-arrow-color": "#0f766e", "width": 1.4, "opacity": 0.55, "line-style": "dashed" } },
          { selector: "edge.partOfGroups", style: { "line-color": "#dc2626", "target-arrow-shape": "triangle", "target-arrow-color": "#dc2626", "width": 1.2, "opacity": 0.5, "line-style": "dotted" } },
          { selector: ".dim", style: { "opacity": 0.08 } },
          { selector: "node.focus", style: { "border-width": 3, "border-color": "#0f766e" } },
          { selector: "node.neighbour", style: { "border-width": 2, "border-color": "#0f766e" } },
          { selector: "edge.incident", style: { "opacity": 1, "width": 2.5 } },
        ],
        layout: LAYOUT_OPTS as any,
      });

      function clearHighlight() { cy.elements().removeClass("dim focus neighbour incident"); }
      function highlight(node: cytoscape.NodeSingular) {
        const nbrs = node.closedNeighborhood();
        cy.elements().not(nbrs).addClass("dim");
        node.addClass("focus");
        nbrs.nodes().not(node).addClass("neighbour");
        nbrs.edges().addClass("incident");
      }

      const panel = document.getElementById("g-panel")!;
      const panelKind = document.getElementById("g-panel-kind")!;
      const panelTitle = document.getElementById("g-panel-title")!;
      const panelOrd = document.getElementById("g-panel-ordid")!;
      const panelNb = document.getElementById("g-panel-neighbors")!;

      function showPanel(node: cytoscape.NodeSingular) {
        const d = node.data();
        panel.classList.remove("hidden");
        panelKind.textContent = d.kind;
        panelTitle.textContent = d.label;
        panelOrd.textContent = d.ordId || "";
        const nb = node.openNeighborhood("node");
        panelNb.textContent = `${nb.length} connection${nb.length === 1 ? "" : "s"}`;
      }

      cy.on("tap", "node", (evt) => { clearHighlight(); const node = evt.target as cytoscape.NodeSingular; highlight(node); showPanel(node); });
      cy.on("tap", (evt) => { if (evt.target === cy) { clearHighlight(); panel.classList.add("hidden"); } });
      document.getElementById("g-panel-close")?.addEventListener("click", () => { panel.classList.add("hidden"); clearHighlight(); });
      document.getElementById("g-fit")?.addEventListener("click", () => cy.fit(undefined, 30));
      document.getElementById("g-relayout")?.addEventListener("click", () => cy.layout({ ...LAYOUT_OPTS, animate: true } as any).run());

      const nodeKindVisible: Record<string, boolean> = { system: true, agent: true, apiResource: true, dataProduct: true, entityType: true, process: false };

      function applyNodeVisibility() {
        const activeFilters: string[] = [];
        document.querySelectorAll<HTMLInputElement>(".edge-toggle[data-edge-filter]").forEach((cb) => { if (cb.checked) activeFilters.push(cb.dataset.edgeKind!); });
        cy.nodes().forEach((node) => {
          const kind = node.data("kind") as string;
          let show = nodeKindVisible[kind] ?? true;
          if (show && activeFilters.length > 0) {
            const resourceKinds = ["agent", "apiResource", "dataProduct"];
            if (resourceKinds.includes(kind)) {
              const hasEdge = activeFilters.some((f) => node.connectedEdges(`.${f}`).length > 0);
              if (!hasEdge) show = false;
            }
          }
          node.style("display", show ? "element" : "none");
        });
        cy.edges().forEach((e) => {
          const srcHidden = e.source().style("display") === "none";
          const tgtHidden = e.target().style("display") === "none";
          if (srcHidden || tgtHidden) { e.style("display", "none"); }
          else {
            const kind = e.classes().filter((c: string) => ["hosts","entities","calls","processNext","partOfGroups"].includes(c))[0];
            const cb = document.querySelector<HTMLInputElement>(`.edge-toggle[data-edge-kind="${kind}"]`);
            e.style("display", (!cb || cb.checked) ? "element" : "none");
          }
        });
      }

      function toggleEdgeKind(kind: string, on: boolean, filterNodes: boolean) {
        cy.edges(`.${kind}`).style("display", on ? "element" : "none");
        if (filterNodes) applyNodeVisibility();
      }

      document.querySelectorAll<HTMLInputElement>(".edge-toggle").forEach((cb) => {
        cb.addEventListener("change", () => toggleEdgeKind(cb.dataset.edgeKind!, cb.checked, cb.dataset.edgeFilter === "true"));
      });
      document.querySelectorAll<HTMLInputElement>(".node-toggle").forEach((cb) => {
        cb.addEventListener("change", () => { nodeKindVisible[cb.dataset.nodeKind!] = cb.checked; applyNodeVisibility(); });
      });

      toggleEdgeKind("processNext", false, false);
      toggleEdgeKind("partOfGroups", false, false);
      nodeKindVisible.process = false;
      applyNodeVisibility();
    </script>
  </body>
</html>
