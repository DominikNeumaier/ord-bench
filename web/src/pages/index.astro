---
import Base from "../layouts/Base.astro";
import {
  loadSystems,
  loadProcesses,
  loadSkills,
  loadRuntimeCases,
  loadDtAnnotations,
} from "../lib/data";

const systems = loadSystems().filter((s) => s.namespace !== "sap.odm");
const processes = loadProcesses();
const skills = loadSkills();
const rtCases = loadRuntimeCases();
const dtCases = loadDtAnnotations();
const totalResources = systems.reduce((n, s) => n + s.resources.length, 0);

const base = import.meta.env.BASE_URL;

const sections = [
  {
    href: "benchmark-concept",
    title: "Benchmark Concept",
    count: "spec",
    countLabel: "document",
    subtitle: "Full benchmark specification",
    blurb: "The full design document: construction methodology, generation pipeline, and ground-truth criteria.",
    group: "dataset",
  },
  {
    href: "landscape",
    title: "Landscape",
    count: `${systems.length}`,
    countLabel: "systems",
    subtitle: `${totalResources} ORD resources`,
    blurb: "Every system in the simulated landscape, with its APIs, agents, data products, and entity types.",
    group: "dataset",
  },
  {
    href: "processes",
    title: "Processes",
    count: `${processes.length}`,
    countLabel: "models",
    subtitle: `${processes.filter((p) => p.kind === "bpmn").length} BPMN · ${processes.filter((p) => p.kind === "cmmn").length} CMMN`,
    blurb: "Repeatable BPMN flows and knowledge-intensive CMMN cases. Each activity carries its ground-truth ORD resource.",
    group: "dataset",
  },
  {
    href: "skills",
    title: "Skills",
    count: `${skills.length}`,
    countLabel: "skills",
    subtitle: "SKILL.md files",
    blurb: "Agent-Skills-Standard skills generated by the design-time flow. Each step lists the pinned ORD resources.",
    group: "dataset",
  },
  {
    href: "test-cases",
    title: "Test Cases",
    count: `${rtCases.length + dtCases.length}`,
    countLabel: "ground-truth cases",
    subtitle: `${rtCases.length} runtime · ${dtCases.length} design-time`,
    blurb: "Ground truth used by the benchmark. Runtime cases grouped by orchestration mode; design-time cases by process.",
    group: "dataset",
  },
  {
    href: "audit",
    title: "Audit",
    count: "3",
    countLabel: "phases",
    subtitle: "Landscape · Design-Time · Run-Time",
    blurb: "Full construction provenance — generation logs, validator outcomes, and judge responses.",
    group: "dataset",
  },
];

const dataset = sections.filter((s) => s.group === "dataset");
---

<Base
  hero={true}
  title="ORD-Bench"
  subtitle="Browse the benchmark artefacts — resource landscape, process models, skills, and test cases."
>
  <div class="text-center mb-14">
    <p class="text-base text-ink-muted max-w-3xl mx-auto mb-4 leading-relaxed">
      The benchmark environment for the thesis <em>Semantically-Grounded Agent Orchestration</em>.
      Browse the landscape, processes, skills, and ground-truth test cases.
    </p>
  </div>

  <!-- Dataset -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-4">
    {dataset.map((s) => (
      <a
        href={`${base}${s.href}/`}
        class="group block border border-rule rounded-lg p-7 bg-white hover:border-accent hover:shadow-md hover:-translate-y-0.5 transition"
      >
        <div class="flex items-baseline justify-between mb-4">
          <h2 class="font-serif text-2xl font-semibold group-hover:text-accent-ink transition">{s.title}</h2>
          <div class="text-right">
            <div class="font-serif text-3xl font-semibold text-accent leading-none">{s.count}</div>
            <div class="text-[10px] uppercase tracking-wider text-ink-subtle font-mono mt-1">{s.countLabel}</div>
          </div>
        </div>
        <div class="text-xs text-ink-subtle font-mono mb-3">{s.subtitle}</div>
        <p class="text-sm text-ink-muted leading-relaxed">{s.blurb}</p>
        <div class="mt-5 text-xs font-mono text-accent opacity-0 group-hover:opacity-100 transition">browse →</div>
      </a>
    ))}
  </div>
</Base>
