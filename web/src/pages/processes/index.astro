---
import Base from "../../layouts/Base.astro";
import { loadProcesses, loadSystems, ordIdToSlug } from "../../lib/data";

const processes = loadProcesses();
const base = import.meta.env.BASE_URL;

const bpmn = processes.filter((p) => p.kind === "bpmn");
const cmmn = processes.filter((p) => p.kind === "cmmn");

const ordIndex = new Map<string, { namespace: string; slug: string; title: string }>();
for (const sys of loadSystems()) {
  for (const r of sys.resources) {
    ordIndex.set(r.ordId, { namespace: sys.namespace, slug: r.slug, title: r.title });
  }
}
---

<Base
  title="Processes"
  subtitle={`${processes.length} models — ${bpmn.length} BPMN (repeatable, application-driven) and ${cmmn.length} CMMN (knowledge-intensive, case-based).`}
>
  <!-- Tabs -->
  <div class="flex gap-0 mb-8 border-b border-rule">
    {[{ id: "bpmn", label: "BPMN", count: bpmn.length }, { id: "cmmn", label: "CMMN", count: cmmn.length }].map((tab) => (
      <button
        data-tab={tab.id}
        class="tab-btn px-5 py-2.5 text-sm font-medium border-b-2 -mb-px transition-colors"
      >
        {tab.label}
        <span class="ml-1.5 font-mono text-xs text-ink-subtle">{tab.count}</span>
      </button>
    ))}
  </div>

  {[{ id: "bpmn", list: bpmn }, { id: "cmmn", list: cmmn }].map(({ id, list }) => (
    <section data-panel={id} class="tab-panel">
      <ul class="divide-y divide-rule border-y border-rule">
        {list.map((p) => {
          const gtActivities = p.activities.filter((a) => a.isGt);
          const nonGt = p.activities.filter((a) => !a.isGt);
          return (
            <li class="py-5">
              <div class="flex items-start justify-between gap-6">
                <div class="min-w-0 flex-1">
                  <a href={`${base}processes/${p.name}/`} class="group">
                    <div class="font-mono text-[10px] text-ink-subtle">{p.file}</div>
                    <div class="mt-0.5 font-semibold text-ink group-hover:underline underline-offset-2">
                      {p.title}
                    </div>
                  </a>
                  {p.description && (
                    <p class="text-xs text-ink-muted mt-1 leading-relaxed max-w-2xl line-clamp-2">
                      {p.description}
                    </p>
                  )}
                  <div class="mt-3 flex flex-wrap gap-1.5">
                    {gtActivities.map((a) => {
                      const r = ordIndex.get(a.expectedOrdIds[0] ?? "");
                      return r ? (
                        <a
                          href={`${base}landscape/${r.namespace}/${r.slug}/`}
                          class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-green-50 border border-green-200 text-[10px] font-mono text-green-700 hover:bg-green-100 transition"
                          title={a.expectedOrdIds[0]}
                        >
                          <span class="w-1.5 h-1.5 rounded-full bg-green-500 shrink-0"></span>
                          {r.title}
                        </a>
                      ) : (
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-green-50 border border-green-200 text-[10px] font-mono text-green-700">
                          <span class="w-1.5 h-1.5 rounded-full bg-green-500 shrink-0"></span>
                          {a.label}
                        </span>
                      );
                    })}
                    {nonGt.map((a) => (
                      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-rule text-[10px] font-mono text-ink-subtle">
                        <span class="w-1.5 h-1.5 rounded-full bg-ink-subtle/40 shrink-0"></span>
                        {a.label}
                      </span>
                    ))}
                  </div>
                </div>
                <a
                  href={`${base}processes/${p.name}/`}
                  class="shrink-0 text-xs text-ink-subtle font-mono hover:text-ink"
                >
                  {p.activities.length} steps →
                </a>
              </div>
            </li>
          );
        })}
      </ul>
    </section>
  ))}
</Base>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>(".tab-btn");
  const panels = document.querySelectorAll<HTMLElement>(".tab-panel");

  function activate(id: string) {
    tabs.forEach((t) => {
      const active = t.dataset.tab === id;
      t.classList.toggle("border-accent", active);
      t.classList.toggle("text-ink", active);
      t.classList.toggle("border-transparent", !active);
      t.classList.toggle("text-ink-subtle", !active);
    });
    panels.forEach((p) => {
      p.style.display = p.dataset.panel === id ? "" : "none";
    });
    sessionStorage.setItem("proc-tab", id);
  }

  const saved = sessionStorage.getItem("proc-tab") ?? "bpmn";
  activate(saved);
  tabs.forEach((t) => t.addEventListener("click", () => activate(t.dataset.tab!)));
</script>

