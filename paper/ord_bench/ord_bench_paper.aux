\newlabel{fig:embedding-validation}{{5}{8}{Embedding cosine grouped by structural tier (37\,128 pairs). Median cosine rises monotonically with the tier (NONE $\to $ HIGH), confirming the field-based metric captures a real difficulty signal independent of embeddings ($r{=}0.63$ with structural score)}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Embedding cosine on the same pairs, clean text (grey) versus enriched text (white). Unlike the structural metric in Fig.~\ref {fig:disambiguation}, embedding cosine \emph  {rises} in every group once semantic text is added. The mixed group ($n{=}14\,210$) covers pairs where only one resource is enriched.}}{9}{figure.caption.11}\protected@file@percent }
\newlabel{fig:disambiguation-embedding}{{6}{9}{Embedding cosine on the same pairs, clean text (grey) versus enriched text (white). Unlike the structural metric in Fig.~\ref {fig:disambiguation}, embedding cosine \emph {rises} in every group once semantic text is added. The mixed group ($n{=}14\,210$) covers pairs where only one resource is enriched}{figure.caption.11}{}}
