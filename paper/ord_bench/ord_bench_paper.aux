\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Extended ambiguity metric: nine dimensions with scoring method, an excerpt of the actual field contents of each resource, and the resulting sub-score for the \texttt  {AssetProvisioningOrchestrator} (A, \texttt  {corp.itsm}) vs \texttt  {AssetLifecycleChangeOrchestrator} (B, \texttt  {sap.s4}) pair. Identical \texttt  {tags} give 1.00, but the disjoint \texttt  {capabilities} and \texttt  {partOfGroups} give 0.00. The three semantic fields are added only when both resources carry them; the denominator grows from 6 to 9 only for those active dimensions. Structural ambiguity therefore falls from 0.75 to 0.53, while embedding cosine rises from 0.79 to 0.82.}}{28}{table.caption.32}\protected@file@percent }
\newlabel{tab:extended-metric}{{7}{28}{Extended ambiguity metric: nine dimensions with scoring method, an excerpt of the actual field contents of each resource, and the resulting sub-score for the \texttt {AssetProvisioningOrchestrator} (A, \texttt {corp.itsm}) vs \texttt {AssetLifecycleChangeOrchestrator} (B, \texttt {sap.s4}) pair. Identical \texttt {tags} give 1.00, but the disjoint \texttt {capabilities} and \texttt {partOfGroups} give 0.00. The three semantic fields are added only when both resources carry them; the denominator grows from 6 to 9 only for those active dimensions. Structural ambiguity therefore falls from 0.75 to 0.53, while embedding cosine rises from 0.79 to 0.82}{table.caption.32}{}}
